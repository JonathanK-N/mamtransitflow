## Copier ce fichier en .env et adapter les valeurs pour le développement local.
#DJANGO_SECRET_KEY=change-moi-en-production
#DJANGO_DEBUG=True
#DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
#CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
#
## PostgreSQL (optionnel) : si POSTGRES_DB est défini, settings.py bascule
## automatiquement de SQLite vers cette base. Renseigner les mêmes valeurs
## que celles utilisées pour créer la base dans pgAdmin.
#POSTGRES_DB=transitflow
#POSTGRES_USER=postgres
#POSTGRES_PASSWORD=change-moi
#POSTGRES_HOST=localhost
#POSTGRES_PORT=5432