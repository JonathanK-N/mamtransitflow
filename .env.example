# TransitFlow — variables d environnement (copier en .env et adapter)
# Auteur : Jonathan K-N
#
# .env n est jamais commite (voir .gitignore) : chaque installation
# (developpement local, staging, client) a ses propres valeurs.

# Base de donnees. Par defaut (si absent), une base SQLite locale est
# utilisee -- pratique pour developper sans Docker. Pour Postgres
# (docker-compose up -d) :
TF_DATABASE_URL=postgresql+psycopg://transitflow:transitflow@localhost:5433/transitflow

# Secret de signature des jetons JWT. À GENERER ALEATOIREMENT ET GARDER
# SECRET en production (ex. : python -c "import secrets; print(secrets.token_hex(32))")
TF_JWT_SECRET=change-moi-en-production
