# TransitFlow — variables d environnement (copier en .env et adapter)
# Auteur : Jonathan K-N
#
# .env n est jamais commite (voir .gitignore) : chaque installation
# (developpement local, staging, client) a ses propres valeurs. Django lit
# ce fichier automatiquement au demarrage (backend/transitflow/settings.py).
# En production sur Railway, ces memes variables sont definies dans l onglet
# "Variables" du service (voir DEPLOIEMENT.md).

# Base de donnees. Si absent, une base SQLite locale est utilisee
# (backend/data/transitflow.db) -- pratique pour developper sans Docker.
# Pour le Postgres de docker-compose.yml (docker compose up -d) :
TF_DATABASE_URL=postgresql://transitflow:transitflow@localhost:5433/transitflow

# Cle secrete Django (signature des jetons JWT...). OBLIGATOIRE en
# production, a generer aleatoirement et a garder secrete :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
TF_SECRET_KEY=change-moi-en-production

# '1' en developpement (messages d erreur detailles), '0' en production.
TF_DEBUG=1

# Domaines autorises a servir l application, separes par des virgules
# (ex. transitflow.exemple.com). Sur Railway, le domaine public du service
# est ajoute automatiquement.
TF_ALLOWED_HOSTS=localhost,127.0.0.1

# Origines HTTPS de confiance pour les formulaires de /django-admin/
# (ex. https://transitflow.exemple.com). Le domaine Railway est ajoute
# automatiquement.
# TF_CSRF_TRUSTED_ORIGINS=

# Duree de vie du jeton d acces, en minutes (le jeton de rafraichissement
# dure 7 jours).
# TF_JETON_MINUTES=60

# Premier compte administrateur, cree au deploiement par
# `python manage.py bootstrap --depuis-env` s il n existe pas encore.
# TF_ADMIN_COURRIEL=admin@exemple.com
# TF_ADMIN_MOT_DE_PASSE=
# TF_ADMIN_NOM=Prenom Nom
