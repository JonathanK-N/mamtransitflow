# TransitFlow — variables d environnement (copier en .env et adapter)
# Auteur : Jonathan K-N
#
# .env n est jamais commite (voir .gitignore) : chaque installation
# (developpement local, staging, client) a ses propres valeurs. Django lit
# ces variables via backend/transitflow/settings.py.

# Base de donnees. Si absent, une base SQLite locale est utilisee --
# pratique pour developper sans Docker. Pour Postgres (docker-compose up -d) :
TF_DATABASE_URL=postgresql+psycopg://transitflow:transitflow@localhost:5433/transitflow

# Cle secrete Django (signature des sessions, jetons JWT...). A GENERER
# ALEATOIREMENT ET GARDER SECRETE en production :
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
TF_SECRET_KEY=change-moi-en-production

# '1' en developpement (messages d erreur detailles), '0' en production.
TF_DEBUG=1

# Domaines autorises a servir l application, separes par des virgules
# (ex. TF_ALLOWED_HOSTS=transitflow.exemple.com). '*' pour le developpement.
TF_ALLOWED_HOSTS=*
